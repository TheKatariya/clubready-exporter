# Your studio's ClubReady login subdomain: https://<SUBDOMAIN>.clubready.com/
CLUBREADY_SUBDOMAIN=yourstudio
CLUBREADY_USER=your_username
# Quote the password if it contains '#' (dotenv treats an unquoted # as a comment)
CLUBREADY_PASS="your_password"
# Where CSVs are written (default ./downloads)
# OUT_DIR=./downloads
# Set to false to watch the browser (debugging)
# HEADLESS=false
